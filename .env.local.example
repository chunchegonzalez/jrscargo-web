# Variables de entorno — JRS CARGO CR
# Copiar como .env.local y configurar valores reales

# WhatsApp (ya configurado en data/rates.ts, no exponer API keys aquí)
NEXT_PUBLIC_WHATSAPP_NUMBER=50672601238

# Tracking API (configurar cuando se proporcione el proveedor)
# El frontend NUNCA ve estas variables (sin prefijo NEXT_PUBLIC_)
TRACKING_API_URL=
TRACKING_API_KEY=

# Google Analytics (opcional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Maps Embed (opcional, para URL personalizada de embed)
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Node environment
NODE_ENV=development
